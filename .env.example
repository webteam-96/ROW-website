# Contact form email (app/contact-us/actions.ts). Copy this file to .env.local (or add the same names in the
# hosting dashboard, e.g. Vercel > Settings > Environment Variables) and fill in the mail account's details.
# The form sends from MAIL_FROM to MAIL_TO; a reply goes to the visitor's own email address.

# The mail server, e.g. smtp.gmail.com (Google Workspace) or smtp.office365.com (Microsoft 365)
SMTP_HOST=
# 587 (STARTTLS) or 465 (SSL)
SMTP_PORT=587
SMTP_USER=noreply@kaizeninfotech.com
# That mailbox's password, or an app password if the account uses 2-step sign-in
SMTP_PASS=

MAIL_FROM=noreply@kaizeninfotech.com
MAIL_TO=web@kaizeninfotech.com
